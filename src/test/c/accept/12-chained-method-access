class myClass {
    private int a;
    private int b;

    public myClass(int a) {
        this.a = a;
        this.b = 0;
    }

    public int getA() {
        return this.a;
    }

    public int getB() {
        return this.b;
    }

    public myClass setA(int n) {
        this.a = n;
        return this;
    }

    public myClass setB(int n) {
        this.b = n;
        return this;
    }
}

int main() {
    myClass obj = new myClass(10);
    obj.setA(20)
        .setB(30)
        .setA(40);
    return obj.getA();
}
